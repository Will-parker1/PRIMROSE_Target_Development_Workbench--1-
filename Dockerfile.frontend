FROM node:22-bookworm-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false

WORKDIR /app

# Install dependencies first so the layer caches independently of source changes.
COPY package.json package-lock.json .npmrc ./
RUN npm ci

# Only the source the vinext build actually touches. backend/web is the
# authoritative workbench UI that scripts/sync-workbench.sh mirrors into
# public/workbench before the build.
COPY next.config.ts tsconfig.json postcss.config.mjs vite.config.ts ./
COPY .openai ./.openai
COPY build ./build
COPY public ./public
COPY app ./app
COPY worker ./worker
COPY scripts/sync-workbench.sh ./scripts/sync-workbench.sh
COPY backend/web ./backend/web

RUN bash scripts/sync-workbench.sh \
    && node_modules/.bin/vinext build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=3000

WORKDIR /app

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

RUN useradd --system --uid 10002 --create-home primrose-web \
    && chown -R primrose-web:primrose-web /app

USER primrose-web
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/workbench/index.html').then(r=>{process.exit(r.ok?0:1)}).catch(()=>process.exit(1))"]

CMD ["node", "node_modules/vinext/dist/cli.js", "start"]
