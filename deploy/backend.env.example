# Required. Generate a random value containing at least 32 characters and use
# the same value as the Sites secret PRIMROSE_BACKEND_TOKEN.
PRIMROSE_BACKEND_TOKEN=

# OpenAI-compatible endpoint used by extraction and GraphRAG. When LM Studio is
# running on the Docker host, host.docker.internal works on Docker Desktop and
# through the host-gateway mapping in compose.owner.yml on Linux.
KG_MODEL_ID=your-exact-gemma-model-id
KG_REASONING_MODEL_ID=your-exact-gemma-model-id
KG_LM_STUDIO_URL=http://host.docker.internal:1234/v1
KG_LM_STUDIO_API_KEY=lm-studio
KG_QUERY_MODE=graphrag
KG_LLM_TIMEOUT=120

# Optional explanation-only Gemma provider. It can use the same endpoint.
PRIMROSE_GEMMA4_MODEL_ID=your-exact-gemma-model-id
PRIMROSE_GEMMA4_BASE_URL=http://host.docker.internal:1234/v1
PRIMROSE_GEMMA4_API_KEY=lm-studio
PRIMROSE_GEMMA4_TIMEOUT=45
PRIMROSE_GEMMA4_RETRIES=1

# Optional schema mission-narrowing role. If omitted, it inherits the
# PRIMROSE_GEMMA4 values above, then the KG_* values.
PRIMROSE_SCHEMA_LLM_MODEL_ID=
PRIMROSE_SCHEMA_LLM_BASE_URL=
PRIMROSE_SCHEMA_LLM_API_KEY=

# Optional model-backed target-development jobs. If omitted, these inherit the
# PRIMROSE_GEMMA4 values and then the KG_* values above.
TARGET_DEVELOPMENT_MODEL_ID=your-exact-gemma-model-id
TARGET_DEVELOPMENT_BASE_URL=http://host.docker.internal:1234/v1
TARGET_DEVELOPMENT_API_KEY=lm-studio
