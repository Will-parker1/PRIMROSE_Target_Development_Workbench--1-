# Copy to deployment/.env and fill in. deployment/.env is gitignored.

# Container registry to push to / pull from — a Docker Hub namespace, an ECR
# repository URI, or a private registry host+path. Required unless you set
# BACKEND_IMAGE and FRONTEND_IMAGE directly below.
REGISTRY=

# Tag applied to both images. A mutable tag (e.g. "dev") is convenient while
# iterating; switch to something immutable (git sha, semver) once this is
# stable, and pair it with IMAGE_PULL_POLICY=IfNotPresent below.
IMAGE_TAG=dev

# Optional: override the full image reference instead of deriving it from
# REGISTRY/IMAGE_TAG. Leave commented to use "${REGISTRY}/primrose-backend:${IMAGE_TAG}"
# and "${REGISTRY}/primrose-frontend:${IMAGE_TAG}".
# BACKEND_IMAGE=
# FRONTEND_IMAGE=

# How the cluster pulls images. "Always" re-pulls on every Pod start, which
# matters if IMAGE_TAG is mutable (otherwise Kubernetes may keep running a
# stale image with the same tag). Use "IfNotPresent" once tags are immutable.
IMAGE_PULL_POLICY=Always

# Namespace to deploy into on the target cluster. If it was already
# provisioned for you (rather than something you're expected to create),
# leave MANAGE_NAMESPACE=false below so deploy.sh doesn't try to touch it.
K8S_NAMESPACE=primrose

# Kubernetes Service type. ClusterIP is the default because it needs no
# extra permissions beyond creating a Service and provisions no AWS
# resources — reach it with `kubectl port-forward svc/primrose 8080:3000`.
# Switch to NodePort or LoadBalancer only once you've confirmed you want
# (and can create) one — LoadBalancer in particular provisions a real,
# billable AWS load balancer.
SERVICE_TYPE=ClusterIP

# Size of the backend's persistent graph/review-state volume.
PVC_SIZE=2Gi

# StorageClass for that volume. Leave empty to use the cluster's default
# class (Minikube's hostpath default, or whatever a real cluster has marked
# default). Set explicitly (e.g. gp2, gp3) if the target cluster has no
# default class — otherwise the PVC will sit Pending indefinitely.
# STORAGE_CLASS=

# --- Permission toggles -----------------------------------------------------
# deploy.sh always attempts these and warns-but-continues on failure rather
# than aborting, since "can create a Deployment" doesn't imply any of these
# other RBAC grants. Set one to false to skip it (and its warning) outright
# once you know for certain you don't have that permission — e.g. if your
# namespace was already provisioned for you, set MANAGE_NAMESPACE=false.
MANAGE_NAMESPACE=true
MANAGE_PVC=true
MANAGE_SECRETS=true
MANAGE_SERVICE_ACCOUNT=true

# Optional: only needed if REGISTRY requires authentication for the CLUSTER
# to pull images (push-time auth is separate — `docker login` /
# `aws ecr get-login-password | docker login` before running
# build-and-push.sh). When both are set, deploy.sh creates an image pull
# secret in K8S_NAMESPACE and attaches it to that namespace's default
# ServiceAccount (gated by MANAGE_SERVICE_ACCOUNT above).
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
