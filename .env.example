# Sites/Worker bridge to the live Python server. Loopback is valid only for
# local development; hosted Sites requires an HTTPS endpoint or private tunnel.
PRIMROSE_BACKEND_URL=http://127.0.0.1:8090
PRIMROSE_BACKEND_TOKEN=

# Original extraction, GraphRAG and target-development model roles use an
# OpenAI-compatible chat-completions endpoint on the Python backend.
KG_MODEL_ID=your-exact-model-id
KG_REASONING_MODEL_ID=your-exact-model-id
KG_LM_STUDIO_URL=http://127.0.0.1:1234/v1
KG_LM_STUDIO_API_KEY=lm-studio
KG_QUERY_MODE=auto
KG_LLM_TIMEOUT=120

# Optional explanation-only Gemma-4 role. The configured identifier is reported
# verbatim; an existing Gemma-3 service is never relabelled as Gemma-4.
PRIMROSE_GEMMA4_MODEL_ID=
PRIMROSE_GEMMA4_BASE_URL=
PRIMROSE_GEMMA4_API_KEY=
PRIMROSE_GEMMA4_TIMEOUT=45
PRIMROSE_GEMMA4_RETRIES=1
PRIMROSE_GEMMA4_PROMPT_VERSION=1.0.0

# Optional schema mission-narrowing role (the "narrow by topic" mission
# statement box). Falls back to PRIMROSE_GEMMA4_* then KG_MODEL_ID /
# KG_LM_STUDIO_URL / KG_LM_STUDIO_API_KEY when left blank.
PRIMROSE_SCHEMA_LLM_MODEL_ID=
PRIMROSE_SCHEMA_LLM_BASE_URL=
PRIMROSE_SCHEMA_LLM_API_KEY=
PRIMROSE_SCHEMA_LLM_TIMEOUT=45
PRIMROSE_SCHEMA_LLM_RETRIES=1
PRIMROSE_SCHEMA_LLM_PROMPT_VERSION=1.0.0

# Optional asynchronous target-development role. These inherit the explicit
# Gemma values above, then KG_* values, when omitted.
TARGET_DEVELOPMENT_MODEL_ID=
TARGET_DEVELOPMENT_BASE_URL=
TARGET_DEVELOPMENT_API_KEY=
